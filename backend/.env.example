# Application Port
PORT=5000

# Database URL:
# For SQLite (local zero-config default):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/storerating_db?schema=public"
# For MySQL:
# DATABASE_URL="mysql://root:password@localhost:3306/storerating_db"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"
JWT_EXPIRES_IN="7d"

# CORS configuration
CORS_ORIGIN="http://localhost:5173"

# Node environment
NODE_ENV="development"
